{
  "version": 2,
  "builds": [
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "staticfiles_build" }
    },
    {
      "src": "nammanagar/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "staticfiles_build/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "nammanagar/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/archive-japams/",
      "schedule": "0 2 * * 0"
    }
  ]
}
